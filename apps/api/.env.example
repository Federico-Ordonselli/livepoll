TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development
# Required, at least 32 random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_KEY=
MONGO_URL=mongodb://127.0.0.1:27017/livepoll
# Comma-separated list of origins allowed by CORS and Socket.io
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8088
# Requests per minute per IP
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_VOTE_PER_MIN=60
