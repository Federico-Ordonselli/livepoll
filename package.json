{
  "name": "livepoll",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "pnpm --filter @livepoll/shared build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:e2e": "pnpm --filter @livepoll/web test:e2e",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "^3.5.3"
  }
}
